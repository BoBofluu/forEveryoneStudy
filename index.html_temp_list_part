        <div id="pageList" class="page">
            <div class="list-control-panel sticky-header">
                <div class="header-main-container" style="display: flex; gap: 20px; align-items: flex-start;">
                    <!-- 左側控制區塊 -->
                    <div style="flex: 1; display: flex; flex-direction: column; gap: 12px;">
                        <!-- 第一列：搜尋欄與排序 -->
                        <div style="display: flex; gap: 12px; align-items: center; width: 100%;">
                            <input type="text" id="searchInput" placeholder="搜尋關鍵字..." onkeyup="renderList()" style="flex: 1; height: 38px;">
                            <select id="sortOrder" onchange="renderList()" class="sort-select" style="width: 100px !important; height: 38px !important;">
                                <option value="newest">最新</option>
                                <option value="oldest">最舊</option>
                            </select>
                        </div>
                        
                        <div id="collapsibleArea" class="header-collapsible-area">
                            <!-- 第二列：Checkbox 選項 -->
                            <div class="search-options" id="searchOptionsContainer" style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 8px; margin-bottom: 12px;">
                                <label><input type="checkbox" id="searchTitle" checked onchange="renderList()">標題</label>
                                <label><input type="checkbox" id="searchCat" checked onchange="renderList()">分類</label>
                                <label><input type="checkbox" id="searchJp" checked onchange="renderList()">日文</label>
                                <label><input type="checkbox" id="searchEn" checked onchange="renderList()">英文</label>
                                <label><input type="checkbox" id="searchNote" checked onchange="renderList()">備註</label>
                                <label><input type="checkbox" id="searchSubcat" checked onchange="renderList()">子分類</label>
                                <div class="option-btns">
                                    <button onclick="toggleSearchCheckboxes(true)">全選</button>
                                    <button onclick="toggleSearchCheckboxes(false)">清除</button>
                                </div>
                            </div>

                            <!-- 第三列：功能按鈕 -->
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <button class="action-btn" onclick="openFilterModal()" style="width: 160px; height: 38px; background-color: var(--input-bg); border: 1px solid #555;">
                                    🔍 篩選分類
                                </button>
                                <button class="action-btn" onclick="exportData()" style="width: 100px; height: 38px; background-color: var(--input-bg); border: 1px solid #555;">📤 匯出資料</button>
                                <button class="action-btn" onclick="importData()" style="width: 100px; height: 38px; background-color: var(--input-bg); border: 1px solid #555;">📥 匯入資料</button>
                                <input type="file" id="importFile" style="display:none;" accept=".json" onchange="handleImport(event)">
                            </div>
                        </div>
                    </div>

                    <!-- 右側：行事曆 (對齊最上方) -->
                    <div id="calendarWrapper" style="flex: 0 0 240px; height: 220px;">
                        <div id="inlineCalendar" class="mini-calendar"></div>
                    </div>
                </div>
            </div>

            <div id="listContainer"></div>
        </div>